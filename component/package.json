{
  "name": "@iquji-web/web-component",
  "version": "0.1.4",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "build": "bun ./scripts/build.mjs",
    "test": "bun test ./src",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.json",
    "check": "bun run build && bun run typecheck && bun run test"
  },
  "peerDependencies": {
    "@base-ui/react": "1.3.0",
    "@tanstack/react-table": "8.21.3",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@base-ui/react": "1.3.0",
    "@biomejs/biome": "2.4.12",
    "@happy-dom/global-registrator": "20.11.6",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "lucide-react": "0.468.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@iquji-web/web-icons": "0.1.4",
    "@iquji-web/web-theme": "0.1.4",
    "@tanstack/react-table": "8.21.3"
  },
  "overrides": {
    "@iquji-web/web-icons": "file:../icons",
    "@iquji-web/web-theme": "file:../theme"
  },
  "description": "React 通用交互组件与布局。",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haydardsx/iquji-community-web.git",
    "directory": "component"
  },
  "homepage": "https://community-web.iquji.com",
  "bugs": {
    "url": "https://github.com/haydardsx/iquji-community-web/issues"
  }
}
