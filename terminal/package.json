{
  "name": "@iquji-community/web-terminal",
  "author": {
    "name": "IQuji Community",
    "email": "community@iqu.lol"
  },
  "version": "0.2.2",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "build": "bun ./scripts/build.mjs",
    "test": "bun test ./src",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.json",
    "check": "bun run build && bun run typecheck && bun run test"
  },
  "peerDependencies": {
    "react": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@happy-dom/global-registrator": "20.11.6",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "description": "支持可注入字节流连接的 React 交互式终端。",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haydardsx/iquji-community-web.git",
    "directory": "terminal"
  },
  "homepage": "https://haydardsx.github.io/iquji-community-web/",
  "bugs": {
    "url": "https://github.com/haydardsx/iquji-community-web/issues"
  }
}
