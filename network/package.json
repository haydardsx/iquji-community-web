{
  "name": "@iquji-web/web-network",
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test-support": {
      "types": "./dist/test-support.d.ts",
      "import": "./dist/test-support.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "bun ./scripts/build.mjs",
    "test": "bun test ./src",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.json",
    "check": "bun run build && bun run typecheck && bun run test"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "description": "可注入 fetch 的 HTTP 传输、取消和 JSON 适配器。",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haydardsx/iquji-community-web.git",
    "directory": "network"
  },
  "homepage": "https://community-web.iquji.com",
  "bugs": {
    "url": "https://github.com/haydardsx/iquji-community-web/issues"
  }
}
