{
  "name": "@iquji-community/web-preview",
  "description": "Community Web 组件使用文档与交互示例。",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "bun src/build-docs.ts && rspress dev",
    "preview": "rspress preview",
    "build": "bun src/build-docs.ts && rspress build && bun src/verify-docs.ts",
    "test": "bun test ./src",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.json",
    "lint": "bun --bun biome check .",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "@iquji-community/web-component": "file:../component",
    "@iquji-community/web-editor": "file:../editor",
    "@iquji-community/web-i18n": "file:../i18n",
    "@iquji-community/web-icons": "file:../icons",
    "@iquji-community/web-motion": "file:../motion",
    "@iquji-community/web-network": "file:../network",
    "@iquji-community/web-query": "file:../query",
    "@iquji-community/web-terminal": "file:../terminal",
    "@iquji-community/web-theme": "file:../theme",
    "@tanstack/react-query": "5.99.2",
    "framer-motion": "12.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@rspress/core": "2.1.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@iquji-community/web-component": "file:../component",
    "@iquji-community/web-editor": "file:../editor",
    "@iquji-community/web-i18n": "file:../i18n",
    "@iquji-community/web-icons": "file:../icons",
    "@iquji-community/web-motion": "file:../motion",
    "@iquji-community/web-network": "file:../network",
    "@iquji-community/web-query": "file:../query",
    "@iquji-community/web-terminal": "file:../terminal",
    "@iquji-community/web-theme": "file:../theme"
  }
}
