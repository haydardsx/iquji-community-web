{
  "name": "@iquji-web/web-preview",
  "description": "Community Web 正式包公开能力的交互预览。",
  "private": true,
  "version": "0.1.4",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "preview": "bun --bun vite preview",
    "build": "bun run check && bun --bun vite build",
    "test": "bun test ./src",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.json",
    "lint": "bun --bun biome check .",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "@iquji-web/web-component": "file:../component",
    "@iquji-web/web-editor": "file:../editor",
    "@iquji-web/web-i18n": "file:../i18n",
    "@iquji-web/web-icons": "file:../icons",
    "@iquji-web/web-motion": "file:../motion",
    "@iquji-web/web-network": "file:../network",
    "@iquji-web/web-query": "file:../query",
    "@iquji-web/web-theme": "file:../theme",
    "@tanstack/react-query": "5.99.2",
    "framer-motion": "12.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.5"
  },
  "overrides": {
    "@iquji-web/web-component": "file:../component",
    "@iquji-web/web-editor": "file:../editor",
    "@iquji-web/web-i18n": "file:../i18n",
    "@iquji-web/web-icons": "file:../icons",
    "@iquji-web/web-motion": "file:../motion",
    "@iquji-web/web-network": "file:../network",
    "@iquji-web/web-query": "file:../query",
    "@iquji-web/web-theme": "file:../theme"
  }
}
