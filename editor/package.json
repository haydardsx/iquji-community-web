{
  "name": "@iquji-cloud/web-editor",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "build": "bun ./scripts/build.mjs",
    "test": "bun test ./src",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.json",
    "check": "bun run build && bun run typecheck && bun run test"
  },
  "peerDependencies": {
    "@base-ui/react": "1.3.0",
    "react": "19.2.4",
    "@tiptap/core": "2.27.2",
    "@tiptap/react": "2.27.2",
    "@tiptap/pm": "2.27.2",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@base-ui/react": "1.3.0",
    "@biomejs/biome": "2.4.12",
    "@happy-dom/global-registrator": "20.11.6",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "lucide-react": "0.468.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "@tiptap/core": "2.27.2",
    "@tiptap/react": "2.27.2",
    "@tiptap/pm": "2.27.2"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@iquji-cloud/web-component": "0.1.0",
    "@iquji-cloud/web-icons": "0.1.0",
    "@iquji-cloud/web-theme": "0.1.0",
    "@tiptap/extension-text-align": "2.27.2",
    "@tiptap/extension-underline": "2.27.2",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "yaml": "2.9.1",
    "@tiptap/starter-kit": "2.27.2"
  },
  "overrides": {
    "@iquji-cloud/web-icons": "file:../icons",
    "@iquji-cloud/web-theme": "file:../theme",
    "@iquji-cloud/web-component": "file:../component"
  },
  "description": "可装配富文本与源码编辑器。",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haydardsx/iquji-community-web.git",
    "directory": "editor"
  },
  "homepage": "https://community-web.iquji.com",
  "bugs": {
    "url": "https://github.com/haydardsx/iquji-community-web/issues"
  }
}
