{
  "name": "@iquji-cloud/web-i18n",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "bun ./scripts/build.mjs",
    "test": "bun test ./src",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.json",
    "check": "bun run build && bun run typecheck && bun run test"
  },
  "peerDependencies": {
    "react": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@happy-dom/global-registrator": "20.11.6",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3"
  },
  "description": "由应用注入词典的 React 国际化状态。",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haydardsx/iquji-community-web.git",
    "directory": "i18n"
  },
  "homepage": "https://community-web.iquji.com",
